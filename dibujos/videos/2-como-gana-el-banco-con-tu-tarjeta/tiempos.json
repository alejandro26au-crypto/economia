  ],
  [
   1027,
   1148,
   "Hogar que paga en efectivo: unos 149 dólares menos al año."
  ],
  [
   1157,
   1225,
   "Hogar con tarjeta: unos 1.133 más."
  ],
  [
   1234,
   1274,
   "Ese es el negocio."
  ],
  [
   1283,
   1344,
   "El banco cobra a la tienda."
  ],
  [
   1353,
   1426,
   "La tienda sube los precios a todos."
  ],
  [
   1435,
   1529,
   "Y parte vuelve en puntos a quien usa tarjeta."
  ],
  [
   1538,
   1600,
   "Por eso el banco gana contigo…"
  ],
  [
   1609,
   1658,
   "aunque nunca pagues intereses."
  ],
  [
   1667,
   1752,
   "¿Y tú, pagas con tarjeta o en efectivo?"
  ]
