 "frases": [
  [
   0,
   130,
   "¡El banco gana contigo… aunque nunca pagues intereses!"
  ],
  [
   134,
   223,
   "Al final vas a entender cómo lo hace con tu tarjeta."
  ],
  [
   241,
   331,
   "Cuando compras con tarjeta, la tienda paga una comisión."
  ],
  [
   348,
   398,
   "Y una parte llega a tu banco."
  ],
  [
   413,
   600,
   "¡Solo en Estados Unidos, 172.000 millones de dólares en comisiones en 2023!"
  ],
  [
   622,
   675,
   "Pero esa no es la única forma."
  ],
  [
   688,
   742,
   "Aunque pagues a tiempo, hay más."
  ],
  [
   758,
   818,
   "Y eso incluye las cuotas de manejo."
  ],
  [
   830,
   853,
   "Las anualidades."
  ],
  [
   853,
   938,
   "¡Y los intereses de quien no paga el total!"
  ],
  [
   958,
   1002,
   "Pero aquí viene lo más raro."
  ],
  [
   1016,
   1130,
   "Pagando siempre a tiempo… sigues siendo rentable para tu banco."
  ],
  [
   1141,
   1216,
   "Porque el negocio no depende solo de tu deuda."
  ],
  [
   1229,
   1314,
   "Esas comisiones la tienda las mete en sus precios."
  ],
  [
   1327,
   1363,
   "Y las pagamos todos."
  ],
  [
   1384,
   1442,
   "La Reserva Federal de Boston lo estimó."
  ],
  [
   1456,
   1584,
   "Un hogar que paga en efectivo pierde unos 149 dólares al año."
  ],
  [
   1595,
   1697,
   "Usas bien tu crédito… y aun así, tu banco gana."
  ],
  [
   1712,
   1787,
   "¿Y tú, pagas con tarjeta o en efectivo?"
  ]
