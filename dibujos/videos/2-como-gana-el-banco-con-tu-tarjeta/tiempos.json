 "frases": [
  [
   6,
   71,
   "Pagas tu tarjeta siempre a tiempo."
  ],
  [
   80,
   131,
   "¡Y el banco gana igual!"
  ],
  [
   140,
   172,
   "Te explico cómo…"
  ],
  [
   181,
   257,
   "sin cobrarte ni un centavo de intereses."
  ],
  [
   266,
   388,
   "Cada vez que pagas con tarjeta, la tienda paga una comisión."
  ],
  [
   397,
   454,
   "Y parte va a tu banco."
  ],
  [
   463,
   537,
   "¿Y quién paga esa comisión de verdad?"
  ],
  [
   546,
   565,
   "Pues tú."
  ],
  [
   574,
   712,
   "Solo en Estados Unidos, 172.000 millones de dólares en comisiones en 2023."
  ],
  [
   721,
   772,
   "¡Y acaban en tus precios!"
  ],
  [
   781,
   819,
   "Y aún es peor."
  ],
  [
   828,
   904,
