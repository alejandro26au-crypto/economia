{
 "frases": [
  [
   6,
   77,
   "Mismo vestido, cinco dólares más caro…"
  ],
  [
   86,
   125,
   "¡y se vendió más!"
  ],
  [
   134,
   243,
   "Vas a entender el truco que tu supermercado usa contigo."
  ],
  [
   252,
   398,
   "Un catálogo de ropa probó el mismo vestido a 44, 49 y 54 dólares."
  ],
  [
   407,
   448,
   "¿El que más vendió?"
  ],
  [
   457,
   484,
   "El de 49."
  ],
  [
   493,
   513,
   "¿Más caro…"
  ],
  [
   522,
   561,
   "y se vende más?"
  ],
  [
   570,
   601,
   "Algo no cuadra."
  ],
  [
   610,
   665,
   "Pero mira tu ticket: 2,99."
  ],
  [
   674,
   684,
   "9,99."
  ],
  [
   693,
   764,
   "Para ti, 2,99 es «dos y algo»."
  ],
  [
   773,
   811,
   "Y aún es peor."
  ],
  [
   820,
   884,
   "¿Crees que solo pasa con chicles?"
  ],
  [
   893,
   947,
   "Pues pasa hasta con coches."
  ],
  [
   956,
   1034,
   "Se estudiaron 22 millones de coches usados."
  ],
  [
   1043,
   1150,
   "Al llegar a 80.000 millas, el precio cae de golpe."
  ],
  [
   1159,
   1245,
   "¡Entre 150 y 200 dólares, por una cifra!"
  ],
  [
   1254,
   1398,
   "Tu cerebro ahorra esfuerzo: lee la primera cifra y casi ignora el resto."
  ],
  [
   1407,
   1475,
   "Se llama efecto del dígito izquierdo."
  ],
  [
   1484,
   1612,
   "Ese es el truco de tu supermercado: precios que acaban en 9."
  ],
  [
   1621,
   1707,
   "Para tu cerebro, 49 es «cuarenta y algo»."
  ],
  [
   1716,
   1799,
   "Por eso el vestido más caro vendió más."
  ],
  [
   1808,
   1851,
   "Mira tu último ticket…"
  ],
  [
   1860,
   1897,
   "¿cuántos nueves cuentas?"
  ]
 ],
